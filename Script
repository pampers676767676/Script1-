btn("Server Hop", function()
    local TS = game:GetService("TeleportService")
    local HS = game:GetService("HttpService")
    local ok, srvs = pcall(function()
        return HS:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?limit=100"))
    end)
    if ok and srvs.data then
        for _, s in ipairs(srvs.data) do
            if s.playing < s.maxPlayers and s.id ~= game.JobId then
                TS:TeleportToPlaceInstance(game.PlaceId, s.id, p); break
            end
        end
    end
end)
