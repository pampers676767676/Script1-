end)

-- ==================== УПРАВЛЕНИЕ ОКНОМ ====================

local minimized = false
local prevSize = m.Size

mini.MouseButton1Click:Connect(function()
    minimized = not minimized
    if minimized then
        prevSize = m.Size
        m.Size = UDim2.new(0, 180, 0, 40)
        c.Visible = false
        mini.Text = "+"
    else
        m.Size = prevSize
        c.Visible = true
        mini.Text = "—"
    end
end)

grow.MouseButton1Click:Connect(function()
    local cur = m.Size.X.Scale
    local newScale = math.min(cur + 0.1, 1.0)
    m.Size = UDim2.fromScale(newScale, newScale * 0.88)
end)

shrink.MouseButton1Click:Connect(function()
    local cur = m.Size.X.Scale
    local newScale = math.max(cur - 0.1, 0.4)
    m.Size = UDim2.fromScale(newScale, newScale * 0.88)
end)

