-- Хелпер: кнопка
local function btn(txt, fn, col)
    local b = Instance.new("TextButton", c)
    b.Size, b.BackgroundColor3 = UDim2.new(1,0,0,46), col or Color3.fromRGB(40,40,40)
    b.Text, b.TextColor3, b.Font, b.TextSize = txt, Color3.new(1,1,1), Enum.Font.Gotham, 15
    Instance.new("UICorner", b).CornerRadius = UDim.new(0,8)
    b.MouseButton1Click:Connect(fn)
    return b
end

-- Хелпер: переключатель (toggle)
local function toggle(txt, state, fn)
    local b = btn(txt .. ": " .. (state and "ON" or "OFF"), function()
        state = not state
        b.Text = txt .. ": " .. (state and "ON" or "OFF")
        b.BackgroundColor3 = state and Color3.fromRGB(0,120,60) or Color3.fromRGB(40,40,40)
        fn(state)
    end)
    if state then b.BackgroundColor3 = Color3.fromRGB(0,120,60) end
    return b
end

